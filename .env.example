# Actual Budget settings

# Port the web app is served on (host side)
APP_PORT=5006

# --- Backups (sidecar container) ---

# Where backup archives are written (folder path on the host)
# NAS / OpenMediaVault (OMV): /srv/dev-disk-by-uuid-XXXX-XXXX/Backups/ActualBudget
# Note: the mount must exist before the container starts - if the NAS share is
# not mounted, Docker creates an empty local folder and backups land there.
BACKUP_DIR=./backups

# How many days of backups to keep (older ones are deleted automatically)
BACKUP_RETENTION_DAYS=30

# What to prefix the archive files with, e.g. actual-backup-2026-09-30_220000.tar.gz
BACKUP_PREFIX=actual-backup

# Run backups daily at 10:30 pm (24h clock). BACKUP_INTERVAL_H is ignored when set.
BACKUP_AT="22:30"

# Container timezone, so BACKUP_AT means your local time
TZ=America/Chicago

