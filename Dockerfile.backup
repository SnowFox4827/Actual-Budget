FROM python:3.11-alpine

WORKDIR /app

COPY backup.py /app/backup.py
RUN chmod +x /app/backup.py

ENV DATA_DIR=/data \
    BACKUP_DIR=/backups \
    BACKUP_RETENTION_DAYS=30 \
    BACKUP_PREFIX=actual-backup \
    BACKUP_INTERVAL_H=24 \
    BACKUP_AT= \
    PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "-u", "/app/backup.py"]
